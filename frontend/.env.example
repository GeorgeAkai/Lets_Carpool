# Backend API URL — set this to your backend Vercel project URL in the Vercel dashboard
# Local dev: leave unset (defaults to http://localhost:8000)
VITE_API_BASE_URL=https://your-backend.vercel.app

# Supabase project (Dashboard -> Settings -> API). Both values are public.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Real-time updates: "websocket" (default on localhost) or "polling" (default elsewhere)
# VITE_REALTIME_STRATEGY=polling
