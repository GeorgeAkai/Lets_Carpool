# Backend API URL — set this to your backend Vercel project URL in the Vercel dashboard
# Local dev: leave unset (defaults to http://localhost:8000)
VITE_API_BASE_URL=https://your-backend.vercel.app

# Neon Auth URL — find this in Neon Console → Project → Branch → Auth
VITE_NEON_AUTH_URL=

# CARTO raster basemap tiles (map view). Free, no account needed for the tier
# used here — request one at carto.com/basemaps/apikey. Without it, tiles load
# but are watermarked "API KEY REQUIRED". This ships in the client bundle, so
# it's a public key by design, not a secret — restrict it by domain in the
# CARTO dashboard if you want to limit who can use it.
VITE_CARTO_API_KEY=
