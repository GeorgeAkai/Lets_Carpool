# Copy to backend/.env for local dev — Vercel reads these from its project
# environment variables dashboard for the deployed backend project.

# Postgres connection string (required) — Supabase: Settings -> Database -> Connection string (needs the postgis extension)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Space-separated list of allowed frontend origins
# Add your frontend Vercel URL here (backend and frontend are separate Vercel projects)
ALLOWED_ORIGINS=http://localhost:5173 https://your-frontend.vercel.app

# Change this to a long random string in production
JWT_SECRET=dev-secret-change-in-production-please

# Supabase project URL used to verify sign-in tokens (required — must match the
# frontend's VITE_SUPABASE_URL). Tokens are checked against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json, with aud="authenticated".
SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy projects that sign with a shared HS256 secret instead of JWKS:
# SUPABASE_JWT_SECRET=
# Optional extra check; Supabase's issuer is <SUPABASE_URL>/auth/v1
# SUPABASE_JWT_ISSUER=

# Google Maps Platform key — the app's primary map provider. Served to the
# browser via GET /config/maps for the Maps JavaScript API (restrict it by HTTP
# referrer) and used server-side for the Routes API (OSRM is the fallback).
# Enable: Maps JavaScript API, Geocoding API, Directions API, Routes API.
MAP_API_KEY=

# Shared secret for GET /cron/expire (Authorization: Bearer <secret>). Vercel Cron
# or Google Cloud Scheduler sends it. Required for the daily expiry sweep.
CRON_SECRET=

# Max DB connections held per backend instance (default 10). On Cloud Run keep
# (max instances x this) below the database's connection limit.
# DB_POOL_MAX=5
