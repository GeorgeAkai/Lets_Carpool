# Copy to backend/.env for local dev — Vercel reads these from its project
# environment variables dashboard for the deployed backend project.

# Neon connection string (required)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Space-separated list of allowed frontend origins
# Add your frontend Vercel URL here (backend and frontend are separate Vercel projects)
ALLOWED_ORIGINS=http://localhost:5173 https://your-frontend.vercel.app

# Change this to a long random string in production
JWT_SECRET=dev-secret-change-in-production-please

# Neon Auth server used to verify sign-in tokens (required — must match the
# frontend's VITE_NEON_AUTH_URL). Find this in Neon Console -> Project -> Branch -> Auth.
NEON_AUTH_URL=https://your-project.neon.tech/auth
# Default JWKS path is the standard OAuth/OIDC well-known discovery path —
# confirmed against a live Neon Auth server (better-auth's plugin-specific
# /jwks route 404s there; this is what's actually served). Only override if
# your project differs:
# NEON_AUTH_JWKS_PATH=/.well-known/jwks.json
# Issuer/audience are NOT checked by default — decode a real signed token from
# your project first to confirm the actual iss/aud claims before setting these;
# a wrong guess here fails every sign-in with no clear error, same as a wrong
# JWKS path does.
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=

# Required to trigger the hourly expiry sweep (/cron/expire and the manual
# /*/expire endpoints) — Vercel automatically sends this as a Bearer token to
# scheduled Cron Job requests when CRON_SECRET is set on the project, so setting
# it here/in Vercel is the only wiring needed. Generate a long random value.
CRON_SECRET=
