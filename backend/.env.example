# Copy to backend/.env for local dev — Vercel reads these from its project
# environment variables dashboard for the deployed backend project.

# Postgres connection string (required). Supabase: Connect → Session pooler.
# Percent-encode special characters in the password. PostGIS and all tables are
# created automatically on startup.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Space-separated list of allowed frontend origins
# Add your frontend Vercel URL here (backend and frontend are separate Vercel projects)
ALLOWED_ORIGINS=http://localhost:5173 https://your-frontend.vercel.app

# Change this to a long random string in production
JWT_SECRET=dev-secret-change-in-production-please

# Supabase project URL, same as the frontend's VITE_SUPABASE_URL (required).
# Sign-in tokens are verified against this project's published signing keys
# (<url>/auth/v1/.well-known/jwks.json), its issuer, and the "authenticated"
# audience.
SUPABASE_URL=https://your-project-ref.supabase.co
# Only for projects still on the legacy HS256 JWT secret (Project Settings →
# API → JWT Settings). Leave unset if your project uses JWT signing keys.
# SUPABASE_JWT_SECRET=

# Required to trigger the hourly expiry sweep (/cron/expire and the manual
# /*/expire endpoints) — Vercel automatically sends this as a Bearer token to
# scheduled Cron Job requests when CRON_SECRET is set on the project, so setting
# it here/in Vercel is the only wiring needed. Generate a long random value.
CRON_SECRET=
